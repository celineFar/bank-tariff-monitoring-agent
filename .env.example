# Copy to .env for local use. Never commit real credentials.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.7-flash
EMBEDDING_MODEL_NAME=gemini-embedding-001
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://tariff:tariff@db:5432/tariff_monitor
SESSION_SERVICE_URI=postgresql+asyncpg://tariff:tariff@db:5432/tariff_monitor
ARTIFACT_TEMP_DIR=data/artifacts

ALLOWED_SOURCE_HOSTS=ameriabank.am,www.ameriabank.am
ALLOWED_DOWNLOAD_MIME_TYPES=application/pdf,text/html
HTTP_USER_AGENT=ameria-tariff-monitor/0.1
SCHEDULE_TIMEZONE=Asia/Yerevan
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
DOWNLOAD_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_RETRY_JITTER_RATIO=0.25
HTTP_MAX_RETRY_DELAY_SECONDS=120
MAX_REDIRECTS=5
MAX_DOWNLOAD_BYTES=26214400
ACQUISITION_BROWSER_ENABLED=true
ACQUISITION_MIN_STATIC_TEXT_CHARS=500
ACQUISITION_BROWSER_NAVIGATION_TIMEOUT_SECONDS=30
ACQUISITION_BROWSER_SETTLE_MILLISECONDS=750
ACQUISITION_MAX_INTERACTIONS=100
ACQUISITION_MAX_NETWORK_PAYLOADS=25
ACQUISITION_MAX_NETWORK_PAYLOAD_BYTES=2097152
ACQUISITION_MAX_LINKED_DOCUMENTS=10
PDF_EXTRACTION_SCHEMA_VERSION=2
PDF_EXTRACTION_PROMPT_VERSION=2
PDF_EXTRACTION_MODEL_NAME=gemini-3.1-flash-lite
PDF_EXTRACTION_FALLBACK_MODEL_NAMES=gemini-3.5-flash-lite,gemini-3.6-flash
PDF_EXTRACTION_MAX_PRICE_PER_MILLION_TOKENS_USD=4.0
PDF_EXTRACTION_MAX_ATTEMPTS=3
PDF_EXTRACTION_BACKOFF_BASE_SECONDS=5
PDF_EXTRACTION_MAX_BACKOFF_SECONDS=60
PDF_EXTRACTION_RETRY_JITTER_RATIO=0.25
PDF_EXTRACTION_PROBE_TEXT_THRESHOLD=20
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=150
SOURCE_DISCOVERY_POLICY_VERSION=1
SOURCE_DISCOVERY_PROMPT_VERSION=1
SOURCE_DISCOVERY_MAX_ITEMS_PER_BATCH=8
SOURCE_DISCOVERY_MAX_CHARS_PER_ITEM=3000
SOURCE_DISCOVERY_MAX_CHARS_PER_BATCH=18000
SOURCE_DISCOVERY_ESTIMATED_CHARS_PER_INPUT_TOKEN=4.0
SOURCE_DISCOVERY_ESTIMATED_OUTPUT_TOKENS_PER_ITEM=160
SOURCE_DISCOVERY_CLASSIFIER_MAX_ATTEMPTS=3
SOURCE_DISCOVERY_CLASSIFIER_BACKOFF_BASE_SECONDS=5
SOURCE_DISCOVERY_CLASSIFIER_MAX_BACKOFF_SECONDS=60
SOURCE_DISCOVERY_CLASSIFIER_RETRY_JITTER_RATIO=0.25
SOURCE_DISCOVERY_FALLBACK_MODEL_NAMES=gemini-3.5-flash-lite,gemini-3.1-flash-lite
SOURCE_DISCOVERY_MAX_PRICE_PER_MILLION_TOKENS_USD=4.0
SEMANTIC_EXTRACTION_SCHEMA_VERSION=5
SEMANTIC_EXTRACTION_PROMPT_VERSION=5
SEMANTIC_EXTRACTION_MAX_EVIDENCE_CHARS_PER_ITEM=5000
SEMANTIC_EXTRACTION_MAX_CHARS_PER_BATCH=20000
SEMANTIC_EXTRACTION_MAX_ITEMS_PER_BATCH=20
SOURCE_DISCOVERY_CLASSIFIER_MAX_ATTEMPTS=3
SOURCE_DISCOVERY_CLASSIFIER_BACKOFF_BASE_SECONDS=5
SOURCE_DISCOVERY_CLASSIFIER_MAX_BACKOFF_SECONDS=60
SOURCE_DISCOVERY_CLASSIFIER_RETRY_JITTER_RATIO=0.25
SOURCE_DISCOVERY_FALLBACK_MODEL_NAMES=gemini-3.5-flash-lite,gemini-3.1-flash-lite
SOURCE_DISCOVERY_MAX_PRICE_PER_MILLION_TOKENS_USD=4.0
SEMANTIC_EXTRACTION_SCHEMA_VERSION=5
SEMANTIC_EXTRACTION_PROMPT_VERSION=5
SEMANTIC_EXTRACTION_MAX_EVIDENCE_CHARS_PER_ITEM=5000
SEMANTIC_EXTRACTION_MAX_CHARS_PER_BATCH=20000
SEMANTIC_EXTRACTION_MAX_ITEMS_PER_BATCH=20
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.25
INTENT_FUZZY_MIN_SCORE=0.82
INTENT_FUZZY_MIN_GAP=0.08
INTENT_MAX_CANDIDATES=5
INTENT_CLASSIFIER_MAX_ATTEMPTS=2
TARIFF_FRESHNESS_DAYS=7
TARIFF_RECENT_CHANGE_DAYS=60
TARIFF_DEFAULT_HISTORY_DAYS=30
TARIFF_MAX_HISTORY_RESULTS=100
TARIFF_RUN_WAIT_SECONDS=120
TARIFF_RUN_POLL_SECONDS=0.5
# structured (default, accepted typed facts) or legacy (old RAG answer path)
TARIFF_ANSWER_READ_MODEL=structured
# Retrieval step trace on its own `tariff.retrieval` logger:
# off | summary (default) | steps | verbose.
# `verbose` prints text projected from source documents; keep it local.
RETRIEVAL_TRACE_LEVEL=summary
# Optional dedicated rotating file for the retrieval trace.
# RETRIEVAL_LOG_FILE=logs/retrieval.log
HITL_DOCUMENT_RANK_GAP=0.05
HITL_LARGE_RATE_CHANGE_PERCENTAGE_POINTS=3
# Required for POST /api/v1/reviews/abort-pending. Keep this secret.
REVIEW_ADMIN_TOKEN=
LOG_LEVEL=INFO
LOG_TIMEZONE=Asia/Yerevan
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
OTEL_TO_CLOUD=false
ALLOW_ORIGINS=http://localhost:3000
