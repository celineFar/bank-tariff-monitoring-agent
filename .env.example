# Copy to .env for local use. Never commit real credentials.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.7-flash
EMBEDDING_MODEL_NAME=gemini-embedding-001
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://tariff:tariff@db:5432/tariff_monitor
SESSION_SERVICE_URI=postgresql+asyncpg://tariff:tariff@db:5432/tariff_monitor
ARTIFACT_TEMP_DIR=data/artifacts
PIPELINE_AUDIT_ENABLED=true
PIPELINE_AUDIT_DIR=artifacts/pipeline-audit

ALLOWED_SOURCE_HOSTS=ameriabank.am,www.ameriabank.am
ALLOWED_DOWNLOAD_MIME_TYPES=application/pdf,text/html
HTTP_USER_AGENT=ameria-tariff-monitor/0.1
SCHEDULE_TIMEZONE=Asia/Yerevan
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
DOWNLOAD_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_RETRY_JITTER_RATIO=0.25
HTTP_MAX_RETRY_DELAY_SECONDS=120
MAX_REDIRECTS=5
MAX_DOWNLOAD_BYTES=26214400
ACQUISITION_BROWSER_ENABLED=true
ACQUISITION_MIN_STATIC_TEXT_CHARS=500
ACQUISITION_BROWSER_NAVIGATION_TIMEOUT_SECONDS=30
ACQUISITION_BROWSER_SETTLE_MILLISECONDS=750
ACQUISITION_MAX_INTERACTIONS=100
ACQUISITION_MAX_NETWORK_PAYLOADS=25
ACQUISITION_MAX_NETWORK_PAYLOAD_BYTES=2097152
ACQUISITION_MAX_LINKED_DOCUMENTS=10
# Reuse an acquisition younger than this instead of fetching again; 0 disables.
ACQUISITION_FRESHNESS_HOURS=1
PDF_EXTRACTION_SCHEMA_VERSION=2
PDF_EXTRACTION_PROMPT_VERSION=2
PDF_EXTRACTION_MODEL_NAME=gemini-3.1-flash-lite
PDF_EXTRACTION_FALLBACK_MODEL_NAMES=
PDF_EXTRACTION_MAX_PRICE_PER_MILLION_TOKENS_USD=1.50
PDF_EXTRACTION_MAX_ATTEMPTS=3
PDF_EXTRACTION_BACKOFF_BASE_SECONDS=5
PDF_EXTRACTION_MAX_BACKOFF_SECONDS=60
PDF_EXTRACTION_RETRY_JITTER_RATIO=0.25
PDF_EXTRACTION_PROBE_TEXT_THRESHOLD=20
PDF_EXTRACTION_SKIP_HISTORICAL=true

# OCR fallback for scanned pages. Requires the optional 'ocr' extra
# (uv sync --extra ocr) and a tesseract binary with the listed language data.
# When the engine or its traineddata is missing the stage reports itself
# unavailable and scanned pages stay empty; nothing is ever guessed.
OCR_ENABLED=true
OCR_LANGUAGES=hye+eng
OCR_RENDER_DPI=200
OCR_MAX_PAGES=20
OCR_MAX_PIXELS_PER_PAGE=40000000
OCR_MIN_CONFIDENCE=60
OCR_TIMEOUT_SECONDS=60
# Windows only: point at the binary when it is not on PATH, e.g.
# OCR_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_TESSERACT_CMD=
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=150
SOURCE_DISCOVERY_POLICY_VERSION=1
SOURCE_DISCOVERY_PROMPT_VERSION=1
SOURCE_DISCOVERY_MAX_ITEMS_PER_BATCH=8
SOURCE_DISCOVERY_MAX_CHARS_PER_ITEM=3000
SOURCE_DISCOVERY_MAX_CHARS_PER_BATCH=18000
SOURCE_DISCOVERY_ESTIMATED_CHARS_PER_INPUT_TOKEN=4.0
SOURCE_DISCOVERY_ESTIMATED_OUTPUT_TOKENS_PER_ITEM=160
SOURCE_DISCOVERY_CLASSIFIER_MAX_ATTEMPTS=3
SOURCE_DISCOVERY_CLASSIFIER_BACKOFF_BASE_SECONDS=5
SOURCE_DISCOVERY_CLASSIFIER_MAX_BACKOFF_SECONDS=60
SOURCE_DISCOVERY_CLASSIFIER_RETRY_JITTER_RATIO=0.25
SOURCE_DISCOVERY_MODEL_NAME=gemini-3.1-flash-lite
SOURCE_DISCOVERY_FALLBACK_MODEL_NAMES=
# Optional successors for the semantic-extraction model; empty means MODEL_NAME only.
SEMANTIC_EXTRACTION_FALLBACK_MODEL_NAMES=
SOURCE_DISCOVERY_MAX_PRICE_PER_MILLION_TOKENS_USD=1.50
SEMANTIC_EXTRACTION_SCHEMA_VERSION=5
SEMANTIC_EXTRACTION_PROMPT_VERSION=5
SEMANTIC_EXTRACTION_MAX_EVIDENCE_CHARS_PER_ITEM=5000
SEMANTIC_EXTRACTION_MAX_CHARS_PER_BATCH=20000
SEMANTIC_EXTRACTION_MAX_ITEMS_PER_BATCH=20
SEMANTIC_EXTRACTION_THINKING_BUDGET=0
SEMANTIC_EXTRACTION_MAX_REPAIRS_PER_RUN=3
RETRIEVAL_TOP_K=8

# Embedding retries are split by what a refusal means. A 5xx is transient and
# clears in seconds; a 429 is a provider quota and clears on its own schedule.
# The quota wait stays in minutes even so: a run must not hold a worker and a
# waiting chat session for a daily quota window. When the quota budget is spent,
# indexing is deferred and the snapshot still publishes -- see
# docs/failure-behavior.md.
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_BACKOFF_BASE_SECONDS=10
EMBEDDING_QUOTA_MAX_ATTEMPTS=4
EMBEDDING_QUOTA_BACKOFF_BASE_SECONDS=30
RETRIEVAL_MIN_SCORE=0.25
INTENT_FUZZY_MIN_SCORE=0.82
INTENT_FUZZY_MIN_GAP=0.08
INTENT_MAX_CANDIDATES=5
INTENT_CLASSIFIER_MAX_ATTEMPTS=2
TARIFF_FRESHNESS_DAYS=7
TARIFF_RECENT_CHANGE_DAYS=60
TARIFF_DEFAULT_HISTORY_DAYS=30
TARIFF_MAX_HISTORY_RESULTS=100
TARIFF_RUN_WAIT_SECONDS=120
TARIFF_RUN_POLL_SECONDS=0.5
# structured (default, accepted typed facts) or legacy (old RAG answer path)
TARIFF_ANSWER_READ_MODEL=structured
# Retrieval step trace on its own `tariff.retrieval` logger:
# off | summary (default) | steps | verbose.
# `verbose` prints text projected from source documents; keep it local.
RETRIEVAL_TRACE_LEVEL=summary
# Optional dedicated rotating file for the retrieval trace.
# RETRIEVAL_LOG_FILE=logs/retrieval.log
HITL_DOCUMENT_RANK_GAP=0.05
HITL_LARGE_RATE_CHANGE_PERCENTAGE_POINTS=3
# Required for POST /api/v1/reviews/abort-pending. Keep this secret.
REVIEW_ADMIN_TOKEN=
LOG_LEVEL=INFO
LOG_TIMEZONE=Asia/Yerevan
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
OTEL_TO_CLOUD=false

# Distributed tracing. Disabled by default; the application runs unchanged.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=tariff-monitor
# Leave unset to print spans to the console, which is enough to verify the
# instrumentation without running a trace backend. With the observability
# profile up, point it at Langfuse:
#   http://langfuse:3000/api/public/otel/v1/traces  (from inside Compose)
#   http://localhost:3001/api/public/otel/v1/traces (from the host)
# OTEL_TRACES_ENDPOINT=
OTEL_EXPORT_TIMEOUT_SECONDS=10
# none   - no prompts or model responses leave the process (default)
# mapped - content is bounded and renamed for the trace backend's input/output
#          panes. Only for a backend you control; it exports source document
#          text. Never set this with a third-party endpoint unless that is
#          an accepted disclosure.
OTEL_TRACE_CONTENT=none
# Do NOT set OTEL_EXPORTER_OTLP_ENDPOINT or OTEL_EXPORTER_OTLP_TRACES_ENDPOINT.
# ADK would add its own exporter for the same spans, bypassing the redaction
# above; the application refuses to enable tracing when it sees them.

# Langfuse (docker compose --profile observability up -d). Local-only defaults;
# generate real values for anything reachable beyond localhost.
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
ALLOW_ORIGINS=http://localhost:3000
