+@pytest.mark.asyncio
+async def test_offerings_route_lists_the_enabled_seed_catalog() -> None:
+    from app.config import load_seed_catalog
+
+    catalog = load_seed_catalog()
+    app = FastAPI()
+    app.state.seed_catalog = catalog
+    app.include_router(router)
+
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(app=app), base_url="http://test"
+    ) as client:
+        response = await client.get("/api/v1/offerings")
+
+    assert response.status_code == 200
+    body = response.json()
+    enabled = [entry for entry in catalog.offerings if entry.enabled]
+    assert [item["offering_id"] for item in body] == [
+        entry.offering_id.value for entry in enabled
+    ]
+    assert body[0] == {
+        "offering_id": enabled[0].offering_id.value,
+        "product": enabled[0].product.value,
+        "seed_url": str(enabled[0].seed_url),
+    }
+
+
