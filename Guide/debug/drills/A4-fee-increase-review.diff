+@pytest.mark.asyncio
+async def test_a_fee_increase_is_reviewed_and_can_be_approved() -> None:
+    from app.domain.review import ReviewDecision, ReviewDecisionType
+    from app.services.monitoring_pipeline import _review_tasks
+    from app.services.review_decisions import ReviewDecisionService
+    from app.services.review_resolution import build_review_view
+    from tests.unit.test_multi_review_approval import _Reviews, _Snapshots
+
+    def fees(amount: str) -> list[dict]:
+        return [
+            {
+                "description": "Loan service fee",
+                "scope": "product",
+                "amount": amount,
+                "currency": "AMD",
+                "rate_pct": None,
+                "conditions": [],
+            }
+        ]
+
+    result = _result(review=True)
+    fee = ValidatedFieldResult(
+        field=ExtractionField.FEES,
+        status=ExtractionStatus.FOUND,
+        value=fees("6000"),
+        evidence=result.validated_fields[0].evidence,
+        batch_id="fees",
+    )
+    partial = result.partial_product.model_copy(
+        update={"fields": (*result.partial_product.fields, fee)}
+    )
+    result = result.model_copy(
+        update={
+            "partial_product": partial,
+            "validated_fields": (*result.validated_fields, fee),
+        }
+    )
+    previous = _snapshot({"fees": {"status": "found", "value": fees("5000")}})
+    lower = {"fees": {"status": "found", "value": fees("4000")}}
+    assert detect_fee_increases(previous.normalized_tariff, lower) == ()
+
+    snapshot = build_snapshot_attempt(
+        run_id=uuid4(),
+        offering_execution_id=uuid4(),
+        product=ProductType.CONSUMER_LOAN,
+        offering_id=OfferingId.CONSUMER_STANDARD,
+        result=result,
+        previous_accepted_snapshot_id=previous.id,
+        previous_accepted_snapshot=previous,
+    )
+
+    reasons = [signal["reason"] for signal in snapshot.validation["review_signals"]]
+    assert reasons == ["fee_increase"]
+    assert snapshot.status is SnapshotStatus.REVIEW_REQUIRED
+    (task,) = _review_tasks(snapshot)
+    view = build_review_view(task, snapshot.evidence)
+    assert ReviewDecisionType.APPROVE in view.allowed_decisions
+    assert "5000" in view.guidance and "6000" in view.guidance
+
+    snapshots = _Snapshots(snapshot)
+    await ReviewDecisionService(_Reviews([task], snapshots), snapshots).apply(
+        task.id,
+        ReviewDecision(decision_type=ReviewDecisionType.APPROVE),
