+def detect_fee_increases(
+    previous: dict[str, JsonValue],
+    current: dict[str, JsonValue],
+) -> tuple[dict[str, JsonValue], ...]:
+    """Any fee amount or percentage that went up since the accepted snapshot.
+
+    Fees are paired as rate entries are, by the words of their description and
+    conditions, never by list position. A fee with no counterpart is structural.
+    """
+    field = ExtractionField.FEES.value
+    increases = [
+        (key, prior[key], now[key])
+        for prior, now in _paired_rate_entries(
+            _fee_entries(previous.get(field)), _fee_entries(current.get(field))
+        )
+        for key in sorted(prior.keys() & now.keys())
+        if now[key] > prior[key]
+    ]
+    if not increases:
+        return ()
+    key, before, after = increases[0]
+    return (
+        {
+            "reason": "fee_increase",
+            "issue_scope": field,
+            "field": field,
+            "previous": f"{before} ({key})",
+            "current": f"{after} ({key})",
+        },
+    )
+
+
+def _fee_entries(
+    value: JsonValue,
+) -> list[tuple[frozenset[str], dict[str, Decimal]]]:
+    items = value.get("value") if isinstance(value, dict) else value
+    entries: list[tuple[frozenset[str], dict[str, Decimal]]] = []
+    for item in items if isinstance(items, list) else ():
+        if not isinstance(item, dict):
+            continue
+        amounts: dict[str, Decimal] = {}
+        for key in ("amount", "rate_pct"):
+            try:
+                amounts[key] = Decimal(str(item[key]))
+            except (KeyError, InvalidOperation):
+                continue
+        if "amount" in amounts:
+            # An amount is compared only with one in the same currency.
+            amounts[f"amount_{item.get('currency')}"] = amounts.pop("amount")
+        if not amounts:
+            continue
+        conditions = item.get("conditions")
+        text = " ".join(
+            (
+                str(item.get("description", "")),
+                *(
+                    str(condition.get("value", ""))
+                    for condition in (
+                        conditions if isinstance(conditions, list) else ()
+                    )
+                    if isinstance(condition, dict)
+                ),
+            )
+        )
+        entries.append((frozenset(_CONDITION_WORD.findall(text.lower())), amounts))
+    return entries
+
