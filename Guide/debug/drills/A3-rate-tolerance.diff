-        if before.get(field) != after.get(field)
+        if _field_changed(field, before.get(field), after.get(field))
     )
     return SnapshotChangeSet(
         id=uuid4(),
@@ -712,6 +714,33 @@ def compare_accepted_snapshots(
     )
 
 
+def _field_changed(field: str, previous: JsonValue, current: JsonValue) -> bool:
+    if field not in _RATE_FIELDS:
+        return previous != current
+    return not _within_rate_tolerance(previous, current)
+
+
+def _within_rate_tolerance(
+    previous: JsonValue, current: JsonValue, key: str | None = None
+) -> bool:
+    """Equal, except that a rate bound may move by less than the tolerance."""
+    if isinstance(previous, dict) and isinstance(current, dict):
+        return previous.keys() == current.keys() and all(
+            _within_rate_tolerance(previous[k], current[k], k) for k in previous
+        )
+    if isinstance(previous, list) and isinstance(current, list):
+        return len(previous) == len(current) and all(
+            _within_rate_tolerance(p, c) for p, c in zip(previous, current, strict=True)
+        )
+    if key in {"min", "max"} and previous is not None and current is not None:
+        try:
+            delta = abs(Decimal(str(previous)) - Decimal(str(current)))
+        except InvalidOperation:
+            return False
+        return delta < _RATE_CHANGE_TOLERANCE
+    return previous == current
+
+
 def evidence_changed(
     previous: SnapshotAttempt | None,
     current: SnapshotAttempt,
