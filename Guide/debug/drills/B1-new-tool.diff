diff --git a/app/tools/catalog.py b/app/tools/catalog.py
new file mode 100644
index 0000000..f2a066d
--- /dev/null
+++ b/app/tools/catalog.py
@@ -0,0 +1,29 @@
+"""`list_supported_products`: the configured families and offerings.
+
+The seed catalog is configuration, not tariff data: this tool reads no grant
+and returns no values, only what the assistant covers.
+"""
+
+from __future__ import annotations
+
+from google.adk.tools import ToolContext
+
+from app.domain.intent import ConversationResolutionState, RequestLanguage
+from app.tools._services import services
+from app.tools._state import RESOLUTION_STATE_KEY
+
+
+async def list_supported_products(tool_context: ToolContext) -> dict[str, object]:
+    """List every product family and offering the assistant covers."""
+    if services.request_resolver is None:
+        return {"status": "unavailable", "reason_code": "catalog.service_unavailable"}
+    try:
+        state = ConversationResolutionState.model_validate(
+            tool_context.state.get(RESOLUTION_STATE_KEY) or {}
+        )
+    except ValueError:
+        state = ConversationResolutionState()
+    return services.request_resolver.catalog_payload(
+        state.conversation_language or RequestLanguage.ENGLISH,
+        complete=True,
+    )
