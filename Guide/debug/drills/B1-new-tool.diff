diff --git a/tests/unit/test_catalog_tool.py b/tests/unit/test_catalog_tool.py
new file mode 100644
index 0000000..9afcf30
--- /dev/null
+++ b/tests/unit/test_catalog_tool.py
@@ -0,0 +1,60 @@
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+
+from app.config import load_seed_catalog
+from app.domain.catalog import CatalogLanguage
+from app.domain.catalog import CatalogLanguage
+from app.domain.intent import RequestIntent
+from app.domain.interpretation import route_for
+from app.tools import configure_services, list_supported_products
+from tests.fixtures.interpretations import scripted_resolver
+
+
+@pytest.fixture
+def wired():
+    configure_services(request_resolver=scripted_resolver())
+    yield
+    configure_services()
+
+
+def test_the_list_intent_routes_to_the_catalog_tool() -> None:
+    assert (
+        route_for(RequestIntent.LIST_SUPPORTED_PRODUCTS) == "list_supported_products"
+    )
+
+
+@pytest.mark.asyncio
+async def test_the_catalog_tool_lists_every_enabled_offering(wired) -> None:
+    catalog = load_seed_catalog()
+    context = SimpleNamespace(
+        state={"intent_resolution": {"conversation_language": "hy"}}
+    )
+
+    result = await list_supported_products(context)
+
+    listed = {
+        offering["offering_id"]
+        for family in result["families"]
+        for offering in family["offerings"]
+    }
+    assert listed == {
+        entry.offering_id.value for entry in catalog.offerings if entry.enabled
+    }
+    assert result["complete"] is True
+    armenian = catalog.families[0].localized_names[CatalogLanguage.ARMENIAN].name
+    assert result["families"][0]["name"] == armenian
+    armenian = catalog.families[0].localized_names[CatalogLanguage.ARMENIAN].name
+    assert result["families"][0]["name"] == armenian
+    assert not any(family["has_more"] for family in result["families"])
+
+
+@pytest.mark.asyncio
+async def test_the_catalog_tool_without_services_is_unavailable() -> None:
+    configure_services()
+
+    result = await list_supported_products(SimpleNamespace(state={}))
+
+    assert result["reason_code"] == "catalog.service_unavailable"
