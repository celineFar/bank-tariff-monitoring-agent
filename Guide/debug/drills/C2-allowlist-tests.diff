+
+
+def test_a_host_outside_the_allowlist_is_rejected() -> None:
+    with pytest.raises(DisallowedSourceUrl, match="not allowlisted: www.acba.am"):
+        validate_source_url("https://www.acba.am/en/individuals/loans", ALLOWED)
+
+
+def test_an_added_host_is_accepted_but_only_that_exact_host() -> None:
+    allowed = (*ALLOWED, "www.acba.am")
+
+    assert validate_source_url("https://www.acba.am/en/individuals/loans", allowed)
+    for url in (
+        "https://acba.am/en/individuals/loans",
+        "https://evil.www.acba.am/loans",
+        "http://www.acba.am/en/individuals/loans",
+    ):
+        with pytest.raises(DisallowedSourceUrl):
+            validate_source_url(url, allowed)
