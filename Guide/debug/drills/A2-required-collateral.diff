+def test_missing_collateral_routes_to_review_until_confirmed_not_stated() -> None:
+    base = _result()
+    missing = base.validated_fields[0].model_copy(
+        update={
+            "field": ExtractionField.COLLATERAL,
+            "status": ExtractionStatus.NOT_STATED,
+            "value": None,
+            "evidence": (),
+        }
+    )
+    result = base.model_copy(
+        update={"validated_fields": (*base.validated_fields, missing)}
+    )
+
+    signals = detect_review_signals(result)
+
+    assert [(item["reason"], item["field"]) for item in signals] == [
+        ("missing_required_field", "collateral")
+    ]
+    assert extraction_is_acceptable(result) is False
+
+    confirmed = missing.model_copy(update={"confirmed_not_stated": True})
+    result = base.model_copy(
+        update={"validated_fields": (*base.validated_fields, confirmed)}
+    )
+    assert detect_review_signals(result) == ()
+    assert extraction_is_acceptable(result) is True
+
