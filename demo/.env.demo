# Demonstration-only overrides, layered on top of .env by docker-compose.demo.yml.
# Every value here exists to let the mirror stand in for a republished bank page.
# No security control is relaxed: the allowlist still admits only named hosts,
# HTTPS is still required, and every other limit keeps its shipped value.

# Admit the local mirror alongside the bank. Exact-host matching still applies;
# app/security/urls.py allows no wildcards.
ALLOWED_SOURCE_HOSTS=ameriabank.am,www.ameriabank.am,tariff-mirror.demo

# The shipped default of 1 hour would reuse the previous acquisition and never
# see the republished page. Zero forces every demonstration run to re-acquire.
ACQUISITION_FRESHNESS_HOURS=0

# certifi plus the demonstration root, written by demo/bin/demo-entrypoint.sh.
SSL_CERT_FILE=/tmp/demo-ca-bundle.pem
